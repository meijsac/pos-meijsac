generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model PlanComercial {
  id                 String    @id @default(cuid())
  nombre             String
  descripcion        String    @default("")
  precio             Float     @default(0)
  precioAnual        Float     @default(0)
  duracionDias       Int
  trialDias          Int       @default(0)
  limiteComprobantes Int
  limiteUsuarios     Int
  documentosAnio     Int       @default(0)
  badge              String    @default("")
  activo             Boolean   @default(true)
  modulos            String    @default("")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  empresas           Empresa[]
}

model Empresa {
  id              String   @id @default(cuid())
  ruc             String   @unique
  razonSocial     String
  nombre          String?
  nombreComercial String?
  direccion       String?
  telefono        String?
  email           String?
  datosRegistro   Json?
  firmaExpira     DateTime?
  planEstado      String   @default("PRUEBA")
  planId          String?
  plan            PlanComercial? @relation(fields: [planId], references: [id], onDelete: SetNull)
  planInicio      DateTime?
  planFin         DateTime?
  metodoPago      String?
  comprobantesUsados Int   @default(0)
  pruebaInicio    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relaciones
  clientes        Cliente[]
  usuarios        Usuario[]
  productos       Producto[]
  proveedores     Proveedor[]
  movimientos     MovimientoInventario[]
  facturas        FacturaEmitida[]
  documentosLegales DocumentoLegal[]
  kardex          KardexMovimiento[]
  transferencias  TransferenciaInventario[]
  inventarioConfig InventarioConfig?
}

model DocumentoLegal {
  id             String   @id @default(cuid())
  empresaId      String   @map("empresa_id")
  empresa        Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipo           String
  nombre         String
  fechaEmision   DateTime @map("fecha_emision")
  fechaCaducidad DateTime @map("fecha_caducidad")
  archivoUrl     String?  @map("archivo_url") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("documentos_legales")
}

model FacturaEmitida {
  id               String    @id @default(cuid())
  empresaId        String
  empresa          Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  estado           String
  payload          Json
  tipoCobro        String?   @map("tipo_cobro")
  estadoPago       String?   @map("estado_pago")
  plazo            Int?
  unidadPlazo      String?   @map("unidad_plazo")
  cuotas           Int?
  fechaVencimiento DateTime? @map("fecha_vencimiento")
  createdAt        DateTime  @default(now())
}

model Usuario {
  id        String   @id @default(cuid())
  nombre    String
  email     String?
  password  String
  rol       String   @default("ADMIN")
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  sesiones  SesionUsuario[]
}

model SesionUsuario {
  id        String   @id
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expira    DateTime
  ip        String   @default("")
  navegador String   @default("")
  revocada  Boolean  @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("sesiones_usuario")
}

model LoginIntento {
  id      String   @id @default(cuid())
  correo  String
  ip      String
  fecha   DateTime @default(now())
  exitoso Boolean
  canal   String   @default("LOGIN")

  @@map("login_intentos")
}

model SeguridadLog {
  id          String   @id @default(cuid())
  empresaId   String?
  usuario     String   @default("")
  ip          String   @default("")
  accion      String
  dispositivo String   @default("")
  detalle     String   @default("")
  fecha       DateTime @default(now())

  @@map("seguridad_logs")
}

model PasswordReset {
  id        String   @id
  usuarioId String
  expira    DateTime
  usado     Boolean  @default(false)

  @@map("password_reset")
}

model UsuarioSeguridad {
  usuarioId   String  @id
  dosFaActivo Boolean @default(false)
  totpCifrado String  @default("")
  respaldos   String  @default("")

  @@map("usuario_seguridad")
}

model Producto {
  id          String   @id @default(cuid())
  codigo      String?
  nombre      String
  categoria   String?
  costo       Float    @default(0)
  precio      Float
  stock       Float    @default(0)
  stockMinimo Float    @default(5)
  ficha       Json?
  empresaId   String
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  movimientos MovimientoInventario[]
  createdAt   DateTime @default(now())

  @@unique([codigo, empresaId])
}

model Cliente {
  id              String     @id @default(cuid())
  empresaId       String
  empresa         Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipoId          String     @default("05")
  identificacion  String
  razonSocial     String
  nombreComercial String?
  tipoCliente     String     @default("DETALLISTA")
  email           String?
  telefono        String?
  direccion       String?
  provincia       String?    @default("PICHINCHA")
  ciudad          String?    @default("QUITO")
  diasCredito     Int        @default(0)
  limiteCredito   Float      @default(0)
  categoria       String     @default("DETALLISTA")
  descuento       Float      @default(0)
  sucursales      Sucursal[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([identificacion, empresaId], name: "identificacion_empresaId")
}

model Sucursal {
  id        String   @id @default(cuid())
  clienteId String
  codigo    String
  nombre    String
  direccion String
  provincia String   @default("PICHINCHA")
  ciudad    String   @default("QUITO")
  telefono  String?
  email     String?
  esMatriz  Boolean  @default(false)
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([clienteId, codigo])
}

model Proveedor {
  id        String   @id @default(cuid())
  ruc       String?
  nombre    String
  telefono  String?
  contacto  String?
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model InventarioConfig {
  empresaId    String   @id
  empresa      Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  metodoCosteo String   @default("PROMEDIO")
  updatedAt    DateTime @updatedAt

  @@map("inventario_config")
}

model KardexMovimiento {
  id              String   @id @default(cuid())
  empresaId       String
  empresa         Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  productoId      String
  productoCodigo  String   @default("")
  productoNombre  String   @default("")
  sucursal        String   @default("PRINCIPAL")
  fecha           DateTime @default(now())
  tipo            String
  detalle         String   @default("")
  cantidadEntrada Float    @default(0)
  cantidadSalida  Float    @default(0)
  costoEntrada    Float    @default(0)
  usuario         String   @default("")
  transferenciaId String?
  createdAt       DateTime @default(now())

  @@index([empresaId, productoId])
  @@map("kardex_movimientos")
}

model TransferenciaInventario {
  id             String   @id @default(cuid())
  empresaId      String
  empresa        Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  fecha          DateTime @default(now())
  origen         String
  destino        String
  productoId     String
  productoCodigo String   @default("")
  productoNombre String   @default("")
  cantidad       Float
  costo          Float
  motivo         String   @default("")
  usuario        String   @default("")
  createdAt      DateTime @default(now())

  @@index([empresaId])
  @@map("transferencias_inventario")
}

model MovimientoInventario {
  id        String   @id @default(cuid())
  tipo      String
  cantidad  Float
  motivo    String?
  productoId String
  producto  Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model CajaTurno {
  id                String   @id @default(cuid())
  fechaApertura     DateTime @default(now())
  fechaCierre       DateTime?
  usuario           String
  puntoEmision      String
  montoInicial      Float
  estado            String   @default("ABIERTA")
  montoCierreFisico Float?
  montoFinal        Float?
  saldoEsperado     Float?
  diferencia        Float?
  dispositivo       String   @default("")
  ultimaActividad   DateTime @default(now())
  movimientos       CajaMovimiento[]
  createdAt         DateTime @default(now())
}

model CajaMovimiento {
  id      String   @id @default(cuid())
  turnoId String
  turno   CajaTurno @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  tipo    String
  monto   Float
  motivo  String?
  fecha   DateTime @default(now())
}