generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model PlanComercial {
  id                 String    @id @default(cuid())
  nombre             String
  descripcion        String    @default("")
  precio             Float     @default(0)
  precioAnual        Float     @default(0)
  duracionDias       Int
  trialDias          Int       @default(0)
  limiteComprobantes Int
  limiteUsuarios     Int
  documentosAnio     Int       @default(0)
  badge              String    @default("")
  activo             Boolean   @default(true)
  modulos            String    @default("")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  empresas           Empresa[]
}

model Empresa {
  id              String   @id @default(cuid())
  ruc             String   @unique
  razonSocial     String
  nombre          String?
  nombreComercial String?
  direccion       String?
  telefono        String?
  email           String?
  datosRegistro   Json?
  firmaExpira     DateTime?
  planEstado      String   @default("PRUEBA")
  planId          String?
  plan            PlanComercial? @relation(fields: [planId], references: [id], onDelete: SetNull)
  planInicio      DateTime?
  planFin         DateTime?
  metodoPago      String?
  comprobantesUsados Int   @default(0)
  pruebaInicio    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relaciones
  clientes        Cliente[]
  usuarios        Usuario[]
  productos       Producto[]
  proveedores     Proveedor[]
  movimientos     MovimientoInventario[]
  facturas        FacturaEmitida[]
  proformas       Proforma[]
  documentosLegales DocumentoLegal[]
  kardex          KardexMovimiento[]
  transferencias  TransferenciaInventario[]
  establecimientos EstablecimientoSri[]
  puntosVenta     PuntoVenta[]
  inventarioConfig InventarioConfig?
  ambienteSri      String   @default("1") @map("ambiente_sri")
  firmaElectronica FirmaElectronica?
  certificadoSri   CertificadoSri?
  miembros         EmpresaUsuario[]
  opticaPacientes  OpticaPaciente[]
  opticaConsultas  OpticaConsulta[]
  opticaOrdenes    OpticaOrden[]
  opticaConfig     OpticaConfig?
}

model FirmaElectronica {
  empresaId  String   @id
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre     String
  titular    String   @default("")
  expira     DateTime
  updatedAt  DateTime @updatedAt

  @@map("firma_electronica")
}

model CertificadoSri {
  empresaId       String   @id @map("empresa_id")
  empresa         Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  storagePath     String   @map("storage_path")
  p12Iv           String   @map("p12_iv")
  p12Tag          String   @map("p12_tag")
  claveCifrada    String   @map("clave_cifrada")
  claveIv         String   @map("clave_iv")
  claveTag        String   @map("clave_tag")
  expira          DateTime
  titular         String   @default("")
  nombre          String   @default("")
  rucCertificado  String   @default("") @map("ruc_certificado")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("certificados_sri")
}

model EmpresaUsuario {
  id        String  @id @default(cuid())
  empresaId String  @map("empresa_id")
  userId    String  @map("user_id")
  rol       String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, userId])
  @@map("empresa_usuarios")
}

model EstablecimientoSri {
  id        String       @id @default(cuid())
  empresaId String
  codigo    String
  nombre    String       @default("")
  direccion String       @default("")
  createdAt DateTime     @default(now())
  empresa   Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  puntos    PuntoVenta[]
  opticaConsultas OpticaConsulta[]
  opticaOrdenes   OpticaOrden[]

  @@unique([empresaId, codigo])
  @@map("establecimientos_sri")
}

model PuntoVenta {
  id                String             @id @default(cuid())
  empresaId         String
  establecimientoId String
  codigo            String
  activo            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  empresa           Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  establecimiento   EstablecimientoSri @relation(fields: [establecimientoId], references: [id], onDelete: Cascade)
  facturas          FacturaEmitida[]

  @@unique([establecimientoId, codigo])
  @@index([empresaId])
  @@map("puntos_venta")
}

model DocumentoLegal {
  id             String   @id @default(cuid())
  empresaId      String   @map("empresa_id")
  empresa        Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipo           String
  nombre         String
  fechaEmision   DateTime @map("fecha_emision")
  fechaCaducidad DateTime @map("fecha_caducidad")
  archivoUrl     String?  @map("archivo_url") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("documentos_legales")
}

model FacturaEmitida {
  id               String    @id @default(cuid())
  empresaId        String
  empresa          Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  estado           String
  sriStatus        String?   @map("sri_status")
  payload          Json
  tipoCobro        String?   @map("tipo_cobro")
  estadoPago       String?   @map("estado_pago")
  plazo            Int?
  unidadPlazo      String?   @map("unidad_plazo")
  cuotas           Int?
  fechaVencimiento DateTime? @map("fecha_vencimiento")
  usuarioId        String?
  puntoVentaId     String?
  usuario          Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  puntoVenta       PuntoVenta? @relation(fields: [puntoVentaId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())

  @@index([empresaId, usuarioId])
}

model Proforma {
  id        String   @id @default(cuid())
  empresaId String   @map("empresa_id")
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  numero    Int
  estado    String   @default("GUARDADA")
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([empresaId, numero])
  @@index([empresaId, createdAt])
  @@map("proformas")
}

model Usuario {
  id        String   @id @default(cuid())
  nombre    String
  email     String?
  password  String
  rol                   String   @default("ADMIN")
  establecimientoCodigo String?  @default("")
  puntoEmisionCodigo    String?  @default("")
  permisos              Json?
  empresaId             String
  empresa               Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())
  sesiones              SesionUsuario[]
  facturas              FacturaEmitida[]
  clientesCreados       Cliente[]
  opticaConsultas       OpticaConsulta[]
  opticaAdendas         OpticaAdenda[]
}

model SesionUsuario {
  id        String   @id
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expira    DateTime
  ip        String   @default("")
  navegador String   @default("")
  revocada  Boolean  @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("sesiones_usuario")
}

model LoginIntento {
  id      String   @id @default(cuid())
  correo  String
  ip      String
  fecha   DateTime @default(now())
  exitoso Boolean
  canal   String   @default("LOGIN")

  @@map("login_intentos")
}

model SeguridadLog {
  id          String   @id @default(cuid())
  empresaId   String?
  usuario     String   @default("")
  ip          String   @default("")
  accion      String
  dispositivo String   @default("")
  detalle     String   @default("")
  fecha       DateTime @default(now())

  @@map("seguridad_logs")
}

model PasswordReset {
  id        String   @id
  usuarioId String
  expira    DateTime
  usado     Boolean  @default(false)

  @@map("password_reset")
}

model UsuarioSeguridad {
  usuarioId   String  @id
  dosFaActivo Boolean @default(false)
  totpCifrado String  @default("")
  respaldos   String  @default("")

  @@map("usuario_seguridad")
}

model Producto {
  id          String   @id @default(cuid())
  codigo      String?
  nombre      String
  categoria   String?
  costo       Float    @default(0)
  precio      Float
  stock       Float    @default(0)
  stockMinimo Float    @default(5)
  ficha       Json?
  empresaId   String
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  movimientos MovimientoInventario[]
  createdAt   DateTime @default(now())

  @@unique([codigo, empresaId])
}

model Cliente {
  id              String     @id @default(cuid())
  empresaId       String
  empresa         Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipoId          String     @default("05")
  identificacion  String
  razonSocial     String
  nombreComercial String?
  tipoCliente     String     @default("DETALLISTA")
  email           String?
  telefono        String?
  direccion       String?
  provincia       String?    @default("PICHINCHA")
  ciudad          String?    @default("QUITO")
  diasCredito     Int        @default(0)
  limiteCredito   Float      @default(0)
  categoria       String     @default("DETALLISTA")
  descuento       Float      @default(0)
  frecuente          Boolean    @default(false)
  creadoPorUsuarioId String?
  creadoPor          Usuario?   @relation(fields: [creadoPorUsuarioId], references: [id], onDelete: SetNull)
  sucursales         Sucursal[]
  opticaOrdenes      OpticaOrden[]
  createdAt          DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([identificacion, empresaId], name: "identificacion_empresaId")
}

model Sucursal {
  id        String   @id @default(cuid())
  clienteId String
  codigo    String
  nombre    String
  direccion String
  provincia String   @default("PICHINCHA")
  ciudad    String   @default("QUITO")
  telefono  String?
  email     String?
  esMatriz  Boolean  @default(false)
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([clienteId, codigo])
}

model Proveedor {
  id        String   @id @default(cuid())
  ruc       String?
  nombre    String
  telefono  String?
  contacto  String?
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model InventarioConfig {
  empresaId    String   @id
  empresa      Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  metodoCosteo String   @default("PROMEDIO")
  updatedAt    DateTime @updatedAt

  @@map("inventario_config")
}

model KardexMovimiento {
  id              String   @id @default(cuid())
  empresaId       String
  empresa         Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  productoId      String
  productoCodigo  String   @default("")
  productoNombre  String   @default("")
  sucursal        String   @default("PRINCIPAL")
  fecha           DateTime @default(now())
  tipo            String
  detalle         String   @default("")
  cantidadEntrada Float    @default(0)
  cantidadSalida  Float    @default(0)
  costoEntrada    Float    @default(0)
  usuario         String   @default("")
  transferenciaId String?
  createdAt       DateTime @default(now())

  @@index([empresaId, productoId])
  @@map("kardex_movimientos")
}

model TransferenciaInventario {
  id             String   @id @default(cuid())
  empresaId      String
  empresa        Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  fecha          DateTime @default(now())
  origen         String
  destino        String
  productoId     String
  productoCodigo String   @default("")
  productoNombre String   @default("")
  cantidad       Float
  costo          Float
  motivo         String   @default("")
  usuario        String   @default("")
  createdAt      DateTime @default(now())

  @@index([empresaId])
  @@map("transferencias_inventario")
}

model MovimientoInventario {
  id        String   @id @default(cuid())
  tipo      String
  cantidad  Float
  motivo    String?
  productoId String
  producto  Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model CajaTurno {
  id                String   @id @default(cuid())
  fechaApertura     DateTime @default(now())
  fechaCierre       DateTime?
  usuario           String
  puntoEmision      String
  empresaId         String?
  puntoVentaId      String?
  montoInicial      Float
  estado            String   @default("ABIERTA")
  montoCierreFisico Float?
  montoFinal        Float?
  saldoEsperado     Float?
  diferencia        Float?
  dispositivo       String   @default("")
  ultimaActividad   DateTime @default(now())
  movimientos       CajaMovimiento[]
  createdAt         DateTime @default(now())
}

model CajaMovimiento {
  id      String   @id @default(cuid())
  turnoId String
  turno   CajaTurno @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  tipo    String
  monto   Float
  motivo  String?
  fecha   DateTime @default(now())
}

model CatalogoSri {
  id             String   @id @default(cuid())
  grupo          String
  codigo         String
  descripcion    String   @default("")
  porcentaje     Float    @default(0)
  vigente        Boolean  @default(true)
  actualizadoEn  DateTime @default(now()) @updatedAt
  actualizadoPor String   @default("")

  @@unique([grupo, codigo])
  @@map("catalogos_sri")
}

model CatalogoSriCambio {
  id      String   @id @default(cuid())
  grupo   String
  codigo  String
  fecha   DateTime @default(now())
  usuario String
  antes   String   @default("")
  despues String   @default("")

  @@map("catalogos_sri_cambios")
}

model OpticaConfig {
  empresaId         String   @id @map("empresa_id")
  empresa           Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  unicodigo         String   @default("")
  registroAcess     String   @default("") @map("registro_acess")
  registroSenescyt  String   @default("") @map("registro_senescyt")
  cedulaProfesional String   @default("") @map("cedula_profesional")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("optica_config")
}

model OpticaPaciente {
  id                  String           @id @default(cuid())
  empresaId           String           @map("empresa_id")
  empresa             Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipoDocumento       String           @default("CEDULA") @map("tipo_documento")
  identificacion      String
  nombres             String
  apellidos           String
  fechaNacimiento     DateTime?        @map("fecha_nacimiento") @db.Date
  sexo                String           @default("")
  telefono            String           @default("")
  email               String           @default("")
  direccion           String           @default("")
  ocupacion           String           @default("")
  consentimientoAt    DateTime?        @map("consentimiento_at")
  consentimientoTexto String           @default("") @map("consentimiento_texto")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  consultas           OpticaConsulta[]
  ordenes             OpticaOrden[]

  @@unique([empresaId, identificacion])
  @@index([empresaId])
  @@map("optica_paciente")
}

model OpticaConsulta {
  id              String         @id @default(cuid())
  empresaId       String         @map("empresa_id")
  empresa         Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  pacienteId      String         @map("paciente_id")
  paciente        OpticaPaciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  usuarioId       String?        @map("usuario_id")
  usuario         Usuario?       @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  usuarioNombre   String         @map("usuario_nombre")
  sucursalId      String?        @map("sucursal_id")
  sucursal        EstablecimientoSri? @relation(fields: [sucursalId], references: [id], onDelete: SetNull)
  fechaHora       DateTime       @default(now()) @map("fecha_hora")
  estado          String         @default("CERRADA")
  cerrada         Boolean        @default(true)
  motivo          String         @default("")
  anamnesis       Json
  lensometria     Json
  agudeza         Json
  examen          Json
  motilidad       Json
  refraccion      Json
  diagnosticos    Json
  plan            String         @default("")
  profesional     Json
  establecimiento Json
  pacienteResumen Json           @map("paciente_resumen")
  createdAt       DateTime       @default(now()) @map("created_at")
  adendas         OpticaAdenda[]
  orden           OpticaOrden?

  @@index([empresaId, fechaHora])
  @@index([pacienteId])
  @@map("optica_consulta")
}

model OpticaAdenda {
  id            String         @id @default(cuid())
  empresaId     String         @map("empresa_id")
  consultaId    String         @map("consulta_id")
  consulta      OpticaConsulta @relation(fields: [consultaId], references: [id], onDelete: Cascade)
  usuarioId     String?        @map("usuario_id")
  usuario       Usuario?       @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  usuarioNombre String         @map("usuario_nombre")
  texto         String
  createdAt     DateTime       @default(now()) @map("created_at")

  @@index([consultaId])
  @@map("optica_adenda")
}

model OpticaOrden {
  id                   String          @id @default(cuid())
  empresaId            String          @map("empresa_id")
  empresa              Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  sucursalId           String?         @map("sucursal_id")
  sucursal             EstablecimientoSri? @relation(fields: [sucursalId], references: [id], onDelete: SetNull)
  consultaId           String?         @unique @map("consulta_id")
  consulta             OpticaConsulta? @relation(fields: [consultaId], references: [id], onDelete: SetNull)
  pacienteId           String          @map("paciente_id")
  paciente             OpticaPaciente  @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  clienteFacturacionId String?         @map("cliente_facturacion_id")
  clienteFacturacion   Cliente?        @relation(fields: [clienteFacturacionId], references: [id], onDelete: SetNull)
  facturaId            String?         @map("factura_id")
  formula              Json
  tipoLente            String          @default("") @map("tipo_lente")
  material             String          @default("")
  observaciones        String          @default("")
  armazonNombre        String          @default("") @map("armazon_nombre")
  lunaNombre           String          @default("") @map("luna_nombre")
  estado               String          @default("PENDIENTE_COTIZAR")
  createdAt            DateTime        @default(now()) @map("created_at")

  @@index([empresaId])
  @@map("optica_orden")
}